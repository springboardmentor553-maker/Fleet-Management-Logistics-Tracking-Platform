# FleetFlow Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=fleetflow_db

# Inside Docker Compose, use the service name "postgres" (not localhost).
# For local non-Docker development, use localhost instead.
DATABASE_URL=postgresql://postgres:your_strong_postgres_password_here@postgres:5432/fleetflow_db

# ─── Security & Authentication ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_strong_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" on cloud deployment to enforce security checks.
ENV=development

# ─── Celery & Redis ──────────────────────────────────────────────────────────
# Inside Docker Compose, use the service name "redis".
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/0

# ─── CORS Allowed Origins ────────────────────────────────────────────────────
# Add your production frontend domain here (comma-separated).
# Example: CORS_ORIGINS=http://localhost:80,https://fleetflow.yourdomain.com
CORS_ORIGINS=http://localhost:80,http://127.0.0.1:80,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ─── Frontend Build-Time Configuration ───────────────────────────────────────
# Specify direct backend URL for production builds. Leaving it blank under local dev
# makes it default to empty string so requests proxy through local development server.
VITE_API_URL=
