# ==============================================================
# FleetFlow Environment Configuration Template
# ==============================================================
# COPY this file to .env and fill in the actual values.
# DO NOT commit the actual .env file to version control.
# ==============================================================

# --------------------------------------------------------------
# Database Configuration
# --------------------------------------------------------------
# The PostgreSQL username
POSTGRES_USER=fleetflow_prod_user
# The PostgreSQL password (MUST be strong and secure)
POSTGRES_PASSWORD=your_secure_password_here
# The PostgreSQL host (use 'db' when running via docker-compose)
POSTGRES_HOST=db
# The PostgreSQL port (inside docker network, usually 5432)
POSTGRES_PORT=5432
# The PostgreSQL database name
POSTGRES_DB=fleetflow_db

# Note: The backend application automatically constructs the DATABASE_URL
# using the above variables. You do not need to set DATABASE_URL manually.

# --------------------------------------------------------------
# Database Connection Pooling (Optional, defaults shown)
# --------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --------------------------------------------------------------
# Security / Authentication
# --------------------------------------------------------------
# The secret key used for signing JWT access tokens (MUST be strong and random)
# E.g. run `openssl rand -hex 32` to generate a secure key
JWT_SECRET_KEY=generate_a_strong_random_key_for_access
# The secret key used for signing JWT refresh tokens
JWT_REFRESH_SECRET_KEY=generate_another_strong_random_key_for_refresh
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------------------
# CORS / Web Configuration
# --------------------------------------------------------------
# Comma-separated list of allowed origins for CORS.
# For production, specify your frontend URLs.
# E.g. ALLOWED_ORIGINS=https://fleetflow.yourdomain.com,https://api.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------
# Third-party Integrations
# --------------------------------------------------------------
# Google Maps API Key for location and routing features
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# --------------------------------------------------------------
# Redis & Celery (Background Tasks)
# --------------------------------------------------------------
# The Redis connection URL
REDIS_URL=redis://redis:6379/0

# --------------------------------------------------------------
# Frontend Build Arguments
# --------------------------------------------------------------
# Note: When building the frontend container for production,
# you must provide this build argument to point to the correct WebSocket URL.
# Example: docker build --build-arg VITE_WS_BASE=wss://api.yourdomain.com ...
# VITE_WS_BASE=ws://localhost:8000
