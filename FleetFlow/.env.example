# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fleetflow_db

# ── Redis ───────────────────────────────────────────────────────────────────
# Connection string for celery broker & backend
REDIS_URL=redis://redis:6379/0

# ── Backend Configurations ──────────────────────────────────────────────────
# Database connection for SQLAlchemy
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# JWT Secrets (Must change in production)
JWT_SECRET_KEY=fleetflow-access-super-secret-key-change-in-prod
JWT_REFRESH_SECRET_KEY=fleetflow-refresh-super-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Maps (For ETA & route calculation in backend)
# Replace with your actual key
GOOGLE_MAPS_API_KEY=AIzaSyD0DVmqiFxogC9GT-OyFWHRxvim8raaweY

# ── Frontend Configurations ─────────────────────────────────────────────────
# WebSocket base URL for live tracking.
# When running locally, localhost:8000 (backend exposed port) works.
VITE_WS_BASE=ws://localhost:8000
