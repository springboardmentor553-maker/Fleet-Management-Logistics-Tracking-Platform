# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string used by the backend
# Local dev: postgresql://postgres:your_password@localhost:5432/fleetflow_db
# Docker compose: postgresql://postgres:postgres@postgres:5432/fleetflow_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleetflow_db

# PostgreSQL credentials for Docker service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=fleetflow_db

# Base URL the frontend uses to reach the backend API
# Local dev: http://127.0.0.1:8000
# Docker: http://localhost:8000
VITE_API_URL=http://localhost:8000

# JWT Token Secret Key & Algorithm
SECRET_KEY=your_production_secret_key_change_me

# Allowed CORS origins (comma-separated URLs)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# Celery & Redis connection settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
